# Copy to .env and replace every CHANGE_ME value.
POSTGRES_DB=fruit_prices
POSTGRES_USER=fruit_app
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://fruit_app:CHANGE_ME_DATABASE_PASSWORD@db:5432/fruit_prices
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET
CREDENTIAL_KEY=CHANGE_ME_FERNET_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SECURE_COOKIES=false
SCRAPE_TIMEOUT_MS=30000
APP_PORT=8000
